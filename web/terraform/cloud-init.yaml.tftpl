#cloud-config

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - jq
  - docker.io

write_files:
  - path: /opt/privalyse/bootstrap.sh
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      LOG_FILE="/var/log/privalyse-bootstrap.log"

      exec > >(tee -a "$LOG_FILE") 2>&1

      echo "========================================"
      echo "Privalyse workspace bootstrap"
      echo "Mode: CPU"
      echo "========================================"

      echo "[1/7] Demarrage de Docker..."
      systemctl enable --now docker

      echo "[2/7] Creation du reseau Docker..."
      docker network create ai-stack 2>/dev/null || true

      echo "[3/7] Creation des volumes Docker..."
      docker volume create ollama-data >/dev/null
      docker volume create open-webui-data >/dev/null

      echo "[4/7] Demarrage d'Ollama en mode CPU..."

      docker rm -f ollama 2>/dev/null || true

      docker run -d \
        --name ollama \
        --network ai-stack \
        -e OLLAMA_KEEP_ALIVE=24h \
        -e OLLAMA_LOAD_TIMEOUT=15m \
        -v ollama-data:/root/.ollama \
        --restart unless-stopped \
        '${ollama_image}'

      echo "[5/7] Attente du demarrage d'Ollama..."

      OLLAMA_READY=false

      for attempt in $(seq 1 120); do
        if docker exec ollama ollama list >/dev/null 2>&1; then
          OLLAMA_READY=true
          break
        fi

        echo "Ollama pas encore pret - tentative $attempt/120"
        sleep 2
      done

      if [ "$OLLAMA_READY" != "true" ]; then
        echo "ERREUR: Ollama n'est pas devenu disponible." >&2
        docker logs ollama || true
        exit 1
      fi

      echo "Ollama disponible."

      echo "[6/7] Telechargement du modele ${ollama_model}..."

      if ! docker exec ollama ollama pull '${ollama_model}'; then
        echo "ERREUR: impossible de telecharger le modele ${ollama_model}." >&2
        docker logs ollama || true
        exit 1
      fi

      echo "Modele ${ollama_model} disponible."

      TRUSTED_ARGS=()

      if [ '${auth_mode}' = 'trusted_header' ]; then
        TRUSTED_ARGS+=(
          -e 'WEBUI_AUTH_TRUSTED_EMAIL_HEADER=${trusted_email_header}'
          -e 'WEBUI_AUTH_TRUSTED_NAME_HEADER=${trusted_name_header}'
          -e 'WEBUI_AUTH_TRUSTED_GROUPS_HEADER=${trusted_groups_header}'
          -e 'WEBUI_AUTH_TRUSTED_ROLE_HEADER=${trusted_role_header}'
        )
      fi

      echo "[7/7] Demarrage d'OpenWebUI..."

      docker rm -f open-webui 2>/dev/null || true

      docker run -d \
        --name open-webui \
        --network ai-stack \
        -p 0.0.0.0:3000:8080 \
        -e ENABLE_SIGNUP=false \
        -e ENABLE_PERSISTENT_CONFIG=false \
        -e ENABLE_WEBSOCKET_SUPPORT=true \
        -e OLLAMA_BASE_URL=http://ollama:11434 \
        -e OLLAMA_BASE_URLS=http://ollama:11434 \
        -e 'WEBUI_SECRET_KEY=${webui_secret_key}' \
        -e 'WEBUI_ADMIN_NAME=${owui_name}' \
        -e 'WEBUI_ADMIN_EMAIL=${owui_email}' \
        -e 'WEBUI_ADMIN_PASSWORD=${owui_password}' \
        -e 'WEBUI_URL=${workspace_url}' \
        "$${TRUSTED_ARGS[@]}" \
        -v open-webui-data:/app/backend/data \
        --restart unless-stopped \
        '${open_webui_image}'

      echo "Attente du demarrage d'OpenWebUI..."

      WEBUI_READY=false

      for attempt in $(seq 1 180); do
        if curl -fsS http://127.0.0.1:3000/ >/dev/null 2>&1; then
          WEBUI_READY=true
          break
        fi

        echo "OpenWebUI pas encore pret - tentative $attempt/180"
        sleep 2
      done

      if [ "$WEBUI_READY" != "true" ]; then
        echo "ERREUR: OpenWebUI n'est pas devenu disponible." >&2
        docker logs open-webui || true
        exit 1
      fi

      mkdir -p /var/lib/privalyse

      cat > /var/lib/privalyse/workspace-info <<EOF
      status=ready
      compute_profile=cpu
      ollama_model=${ollama_model}
      openwebui_port=3000
      EOF

      touch /var/lib/privalyse/bootstrap-success

      echo "========================================"
      echo "Workspace Privalyse pret"
      echo "Mode: CPU"
      echo "Modele: ${ollama_model}"
      echo "OpenWebUI: http://127.0.0.1:3000"
      echo "========================================"

runcmd:
  - [bash, /opt/privalyse/bootstrap.sh]

final_message: "Bootstrap Privalyse termine"