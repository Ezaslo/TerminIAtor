#cloud-config
package_update: true
package_upgrade: false
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - docker.io

write_files:
  - path: /opt/privalyse/bootstrap.sh
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      systemctl enable --now docker

      # Le flavor GPU OVH doit fournir un pilote NVIDIA fonctionnel.
      if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo "Pilote NVIDIA absent" >&2
        exit 1
      fi

      curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
        | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
      curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
        | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
        > /etc/apt/sources.list.d/nvidia-container-toolkit.list
      apt-get update
      apt-get install -y nvidia-container-toolkit
      nvidia-ctk runtime configure --runtime=docker
      systemctl restart docker

      docker network create ai-stack 2>/dev/null || true
      docker volume create ollama-data
      docker volume create open-webui-data

      docker run -d --name ollama \
        --network ai-stack \
        --gpus all \
        -e OLLAMA_KEEP_ALIVE=24h \
        -e OLLAMA_LOAD_TIMEOUT=15m \
        -v ollama-data:/root/.ollama \
        --restart unless-stopped \
        '${ollama_image}'

      for attempt in $(seq 1 120); do
        docker exec ollama ollama list >/dev/null 2>&1 && break
        sleep 2
      done

      docker exec ollama ollama pull '${ollama_model}'

      TRUSTED_ARGS=()
      if [ '${auth_mode}' = 'trusted_header' ]; then
        TRUSTED_ARGS+=(
          -e 'WEBUI_AUTH_TRUSTED_EMAIL_HEADER=${trusted_email_header}'
          -e 'WEBUI_AUTH_TRUSTED_NAME_HEADER=${trusted_name_header}'
          -e 'WEBUI_AUTH_TRUSTED_GROUPS_HEADER=${trusted_groups_header}'
          -e 'WEBUI_AUTH_TRUSTED_ROLE_HEADER=${trusted_role_header}'
        )
      fi

      docker run -d --name open-webui \
        --network ai-stack \
        -p 0.0.0.0:3000:8080 \
        -e ENABLE_SIGNUP=false \
        -e ENABLE_PERSISTENT_CONFIG=false \
        -e ENABLE_WEBSOCKET_SUPPORT=true \
        -e OLLAMA_BASE_URL=http://ollama:11434 \
        -e OLLAMA_BASE_URLS=http://ollama:11434 \
        -e 'WEBUI_SECRET_KEY=${webui_secret_key}' \
        -e 'WEBUI_ADMIN_NAME=${owui_name}' \
        -e 'WEBUI_ADMIN_EMAIL=${owui_email}' \
        -e 'WEBUI_ADMIN_PASSWORD=${owui_password}' \
        -e 'WEBUI_URL=${workspace_url}' \
        "$${TRUSTED_ARGS[@]}" \
        -v open-webui-data:/app/backend/data \
        --restart unless-stopped \
        '${open_webui_image}'

      for attempt in $(seq 1 180); do
        curl -fsS http://127.0.0.1:3000/ >/dev/null 2>&1 && exit 0
        sleep 2
      done

      echo "OpenWebUI n'est pas devenu disponible" >&2
      exit 1

runcmd:
  - [bash, /opt/privalyse/bootstrap.sh]

final_message: "Bootstrap Privalyse termine"
